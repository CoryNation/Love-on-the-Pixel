# Cursor AI ignore file - improves performance and reliability
# by excluding build artifacts, dependencies, and generated files

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/

# Build outputs
.next/
dist/
out/
build/
coverage/

# Generated files
*.min.js
*.map
*.tsbuildinfo
next-env.d.ts

# Lock files (keep package-lock.json for Git but ignore for Cursor)
*.lock

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Images in public directory (often large and not needed for code analysis)
public/**/*.png
public/**/*.jpg
public/**/*.jpeg
public/**/*.gif
public/**/*.webp
public/**/*.svg

# Cache directories
**/.turbo
**/.cache
**/.eslintcache
**/.vite
**/.vercel

# IDE and system files
.DS_Store
*.pem
.vscode/
.idea/

# Environment files
.env*

# Android build artifacts (you have android-app/ directory)
android-app/build/
android-app/.gradle/
android-app/local.properties

# Supabase functions (already in .gitignore but good to be explicit)
supabase/functions/
